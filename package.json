{
  "name": "opencode-syncthing-plugin",
  "version": "0.1.0",
  "description": "Sync OpenCode sessions via Syncthing (mimics opencode-sync-plugin)",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "opencode-syncthing": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepare": "npm run build"
  },
  "keywords": ["opencode", "plugin", "syncthing", "sync"],
  "author": "davidinux",
  "license": "MIT",
  "dependencies": {
    "@opencode-ai/plugin": "^1.1.25",
    "syncthing": "^1.0.0",
    "commander": "^12.0.0",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.11.0"
  }
}
