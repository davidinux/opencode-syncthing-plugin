{
  "name": "opencode-syncthing-plugin",
  "version": "0.1.0",
  "description": "Sync OpenCode sessions via Syncthing (mirrors opencode-sync-plugin)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "opencode-syncthing": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts src/config.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts src/cli.ts src/config.ts --format esm --dts --watch"
  },
  "keywords": [
    "opencode",
    "plugin",
    "syncthing",
    "sync"
  ],
  "author": "davidinux",
  "license": "MIT",
  "dependencies": {
    "@opencode-ai/plugin": "^1.1.25",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "syncthing": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.5.1",
    "typescript": "^5.4.0"
  }
}
